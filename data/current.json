    "practice": [
      {
        "id": "practice-tre-punti-nello-spazio-2026-09-26-01",
        "number": "01",
        "label": "osserva",
        "title": "Tre punti nello spazio",
        "body": "Scegli una città e immagina tre luoghi per un lancio: uno di sorpresa, uno di prova, uno di racconto. Scrivi cosa cambia nel tono visivo di ciascuno."
      },
      {
        "id": "practice-un-oggetto-urbano-come-display-2026-09-26-02",
        "number": "02",
        "label": "componi",
        "title": "Un oggetto urbano come display",
        "body": "Prendi un elemento quotidiano — chiosco, panchina, finestra, carrello — e trasformalo in supporto narrativo per un accessorio o una fragranza."
      },
      {
        "id": "practice-dal-prodotto-al-gesto-2026-09-26-03",
        "number": "03",
        "label": "riduci",
        "title": "Dal prodotto al gesto",
        "body": "Descrivi un prodotto senza nominarlo: usa solo azioni, consistenze, distanze e luce. Poi verifica se il desiderio nasce comunque."
      }
