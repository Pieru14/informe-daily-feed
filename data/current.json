    "updates": [
      {
        "id": "dolce-gabbana-dolce-gabbana-alla-milano-beauty-week-2026-2026-09-26-01",
        "brand": "Dolce&Gabbana",
        "label": "beauty / evento locale / esperienza immersiva · 16–20 settembre 2026; fonte: settembre 2026",
        "title": "Dolce&Gabbana alla Milano Beauty Week 2026",
        "perspective": "Fatto: Dolce&Gabbana documenta la partecipazione alla quinta edizione di Milano Beauty Week, dal 16 al 20 settembre 2026, con un percorso tra fragranze, make-up ed esperienze sensoriali a Milano; sono citati un carretto itinerante dedicato alle fragranze Devotion, il Grand Tour Beauty del 19 settembre in Via Kramer 18, l’edicola Your Devotion in Corso Venezia 19 e la boutique di Via della Spiga 2. Comunicazione: il racconto traduce il beauty in formato urbano e attraversabile: carretto, edicola, boutique e masterclass compongono una mappa fisica più che una sola campagna immagine. I codici osservabili sono italianità dichiarata, viaggio sensoriale, rituale beauty, prossimità cittadina. Can&/",
        "source": "Dolce&Gabbana World",
        "url": "https://world.dolcegabbana.com/it/beauty/dolce-gabbana-milano-beauty-week-fragranze-makeup-experience-2026"
      }
    ]
  },
  "dailyEdition": {
    "refreshedAt": "26 settembre 2026 · edizione 11",
    "focus": {
      "id": "focus-quando-il-beauty-diventa-percorso-cittadino-2026-09-26-11",
      "eyebrow": "THE DAILY FILE / 011",
      "title": "Quando il beauty diventa percorso cittadino",
      "body": "Il segnale più utile è il passaggio dalla campagna alla traiettoria: Dolce&Gabbana non concentra il racconto in un unico set, ma lo distribuisce tra vie, indirizzi e formati riconoscibili di Milano. Per il confronto competitivo è interessante osservare come il prodotto beauty venga comunicato come esperienza di prossimità: una fragranza può essere incontrata in strada, provata in boutique, approfondita in masterclass. Il canale non è solo digitale o retail; è una piccola geografia di marca.",
      "source": "Dolce&Gabbana World",
      "url": "https://world.dolcegabbana.com/it/beauty/dolce-gabbana-milano-beauty-week-fragranze-makeup-experience-2026"
    },
    "directions": [
      {
        "id": "direction-disegna-una-mappa-non-un-annuncio-2026-09-26-01",
        "tone": "blue",
        "category": "format urbano",
        "title": "Disegna una mappa, non un annuncio",
        "body": "Trasforma un lancio in una sequenza di tappe fisiche: un punto di scoperta, uno di prova, uno di approfondimento. La narrazione cresce quando il pubblico può attraversarla."
      },
      {
        "id": "direction-fai-parlare-il-gesto-prima-del-prodotto-2026-09-26-02",
        "tone": "pink",
        "category": "codici sensoriali",
        "title": "Fai parlare il gesto prima del prodotto",
        "body": "Se il tema è beauty, mostra il rito: applicare, annusare, scegliere, guardarsi. Il messaggio diventa più vicino quando passa da mani, superfici e piccoli movimenti."
      },
      {
        "id": "direction-usa-l-indirizzo-come-parte-del-racconto-2026-09-26-03",
        "tone": "lime",
        "category": "retail e città",
        "title": "Usa l’indirizzo come parte del racconto",
        "body": "Un luogo reale può diventare codice visivo: edicola, boutique, strada, stanza. Osserva come l’ambiente cambia il tono del prodotto senza doverlo spiegare troppo."
      }
    ],
