    "updates": [
      {
        "id": "burberry-burberry-presenta-170-the-anniversary-portraits-2026-09-30-01",
        "brand": "Burberry",
        "publishedOn": "2026-09-28",
        "publishedAt": null,
        "publicationEvidence": "Data visibile sotto il titolo: 28 Sept 2026",
        "addedAt": "2026-09-30T19:27:44.380Z",
        "geography": "Globale",
        "geographyEvidence": "La fonte documenta una campagna con ritratti realizzati a London, New York, Seoul e Shanghai; non prova un’attivazione in Italia.",
        "label": "campagna / anniversario / outerwear · 170: The Anniversary Portraits; anniversario dei",
        "title": "Burberry presenta “170: The Anniversary Portraits”",
        "perspective": "Fatto: Burberry pubblica una nuova campagna per i 170 anni della maison, costruita attorno all’outerwear e a dieci modelli di capospalla, con ritratti fotografati da Jack Day e un film diretto da Hector Aponysus. Comunicazione: il formato corale — 170 persone in quattro città — sposta il trench e il capospalla dal simbolo heritage al ritratto d’uso, dove la stessa forma cambia tono attraverso postura, strada e identità individuale. Da osservare: il codice più interessante è la serialità del ritratto urbano, utile per confrontare come i brand storici trasformano un anniversario in archivio vivo anziché in pura celebrazione retrospettiva.",
        "source": "Burberry plc",
        "url": "https://www.burberryplc.com/news/brand/2026/burberry-presents-170-the-anniversary-portraits"
      }
    ]
  },
  "dailyEdition": {
    "refreshedAt": "30 settembre 2026 · edizione 12",
    "focus": {
      "id": "focus-il-capospalla-come-ritratto-non-come-reliquia-2026-09-30-12",
      "eyebrow": "THE DAILY FILE / 012",
      "title": "Il capospalla come ritratto, non come reliquia",
      "body": "La forza del segnale Burberry sta nel trattare l’archivio come una grammatica aperta: dieci forme di outerwear diventano dispositivi di differenza, non pezzi da museo. L’anniversario non è raccontato attraverso una cronologia lineare, ma tramite corpi, città e variazioni d’uso: un modo contemporaneo di comunicare heritage senza immobilizzarlo.",
      "source": "Burberry plc",
      "url": "https://www.burberryplc.com/news/brand/2026/burberry-presents-170-the-anniversary-portraits"
    },
    "directions": [
      {
        "id": "direction-serie-di-gesti-ordinari-2026-09-30-01",
        "tone": "blue",
        "category": "campagna",
        "title": "Serie di gesti ordinari",
        "body": "Costruisci una sequenza visiva attorno a un solo capo, evitando la posa eroica. Fai emergere differenze minime: mani in tasca, colletto alzato, passo interrotto, attesa alla soglia."
      },
      {
        "id": "direction-archivio-con-temperatura-umana-2026-09-30-02",
        "tone": "pink",
        "category": "heritage",
        "title": "Archivio con temperatura umana",
        "body": "Quando lavori su un codice storico, non mostrarlo solo come icona. Inseriscilo in situazioni vive, con imperfezioni leggere, perché il passato diventi materiale da abitare."
      },
      {
        "id": "direction-una-citta-molte-letture-2026-09-30-03",
        "tone": "lime",
        "category": "formato",
        "title": "Una città, molte letture",
        "body": "Scegli un elemento fisso e ripetilo in contesti diversi. La variazione di luce, sfondo e corpo può dire più di una narrazione esplicativa."
      }
    ],
