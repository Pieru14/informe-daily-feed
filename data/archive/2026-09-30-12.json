    "notes": [
      {
        "id": "note-la-moltiplicazione-come-prova-di-attualita-2026-09-30-01",
        "type": "field note",
        "title": "La moltiplicazione come prova di attualità",
        "body": "Il numero 170 diventa un principio visivo: non solo anniversario, ma campionatura di persone, città e modi di portare il capospalla. La ripetizione rende leggibile la continuità senza chiuderla in nostalgia.",
        "source": "Burberry plc",
        "url": "https://www.burberryplc.com/news/brand/2026/burberry-presents-170-the-anniversary-portraits"
      },
      {
        "id": "note-outerwear-come-interfaccia-sociale-2026-09-30-02",
        "type": "field note",
        "title": "Outerwear come interfaccia sociale",
        "body": "Il capospalla è raccontato come soglia tra corpo e clima, ma anche tra individuo e strada. La comunicazione lavora su protezione, movimento e riconoscibilità, più che su spettacolarità di passerella.",
        "source": "Burberry plc",
        "url": "https://www.burberryplc.com/news/brand/2026/burberry-presents-170-the-anniversary-portraits"
      },
      {
        "id": "note-quattro-citta-nessuna-promessa-universale-2026-09-30-03",
        "type": "field note",
        "title": "Quattro città, nessuna promessa universale",
        "body": "La fonte nomina London, New York, Seoul e Shanghai: il respiro è internazionale, ma non autorizza a parlare di attivazione italiana. L’etichetta corretta resta Globale, con geografia documentata dalla campagna.",
        "source": "Burberry plc",
        "url": "https://www.burberryplc.com/news/brand/2026/burberry-presents-170-the-anniversary-portraits"
      }
    ],
    "practice": [
      {
        "id": "practice-dieci-variazioni-su-un-solo-capo-2026-09-30-01",
        "number": "01",
        "label": "Esercizio 1",
        "title": "Dieci variazioni su un solo capo",
        "body": "Disegna o fotografa lo stesso capo in dieci posture diverse. Non cambiare styling in modo eccessivo: lascia che siano gesto, peso e distanza a generare racconto."
      },
      {
        "id": "practice-mappa-di-un-archivio-quotidiano-2026-09-30-02",
        "number": "02",
        "label": "Esercizio 2",
        "title": "Mappa di un archivio quotidiano",
        "body": "Scegli un oggetto del tuo guardaroba e scrivi tre memorie, tre usi pratici e tre possibili trasformazioni. Poi traduci una di queste tracce in un’immagine."
      },
      {
        "id": "practice-ritratto-senza-volto-protagonista-2026-09-30-03",
        "number": "03",
        "label": "Esercizio 3",
        "title": "Ritratto senza volto protagonista",
        "body": "Realizza un’immagine in cui il volto non sia il centro. Lavora su collo, spalle, mani, orlo e camminata: fai parlare il capo attraverso il corpo."
      }
    ]
  },
